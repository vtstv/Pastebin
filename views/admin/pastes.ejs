<%- include('../partials/admin-header', { 
    title: 'Manage Pastes', 
    pageTitle: 'Manage Pastes',
    page: 'pastes'
}) %>
            <div class="admin-section">
                <div class="pastes-header">
                    <h2>All Pastes</h2>
                    <div class="results-info">
                        Total: <%= result.total %> | Page <%= result.page %> of <%= result.totalPages %>
                    </div>
                </div>

                <div class="pastes-table">
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Title</th>
                                <th>Language</th>
                                <th>Created</th>
                                <th>Views</th>
                                <th>Expires</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% result.data.forEach(function(paste) { %>
                                <tr class="<%= paste.isDeleted ? 'deleted' : '' %>">
                                    <td class="paste-id">
                                        <a href="/paste/<%= paste.id %>" target="_blank">
                                            <%= paste.id.substring(0, 8) %>...
                                        </a>
                                    </td>
                                    <td class="paste-title">
                                        <%= paste.title || 'Untitled' %>
                                    </td>
                                    <td class="paste-language">
                                        <% if (paste.language) { %>
                                            <span class="language-tag"><%= paste.language %></span>
                                        <% } else { %>
                                            -
                                        <% } %>
                                    </td>
                                    <td class="paste-created">
                                        <%= paste.createdAt.toLocaleString() %>
                                    </td>
                                    <td class="paste-views">
                                        <%= paste.views %>
                                    </td>
                                    <td class="paste-expires">
                                        <% if (paste.expiresAt) { %>
                                            <%= paste.expiresAt.toLocaleString() %>
                                        <% } else { %>
                                            Never
                                        <% } %>
                                    </td>
                                    <td class="paste-status">
                                        <% if (paste.isDeleted) { %>
                                            <span class="status-deleted">Deleted</span>
                                        <% } else if (paste.expiresAt && new Date() > paste.expiresAt) { %>
                                            <span class="status-expired">Expired</span>
                                        <% } else if (!paste.isPublic) { %>
                                            <span class="status-private">Private</span>
                                        <% } else { %>
                                            <span class="status-active">Active</span>
                                        <% } %>
                                    </td>
                                    <td class="paste-actions">
                                        <% if (!paste.isDeleted) { %>
                                            <button onclick="deletePaste('<%= paste.id %>')" class="delete-btn">Delete</button>
                                        <% } %>
                                        <a href="/raw/<%= paste.id %>" target="_blank" class="view-btn">Raw</a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <% if (result.totalPages > 1) { %>
                    <div class="pagination">
                        <% if (result.page > 1) { %>
                            <a href="?page=<%= result.page - 1 %>">&larr; Previous</a>
                        <% } %>
                        
                        <span>Page <%= result.page %> of <%= result.totalPages %></span>
                        
                        <% if (result.page < result.totalPages) { %>
                            <a href="?page=<%= result.page + 1 %>">Next &rarr;</a>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </main>
    </div>

    <script>
        function deletePaste(id) {
            console.log('deletePaste called with id:', id);
            
            if (!confirm('Are you sure you want to delete this paste?')) {
                return;
            }
            
            fetch(`/admin/pastes/${id}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json'
                },
                credentials: 'same-origin'
            })
            .then(response => {
                console.log('Response status:', response.status);
                if (!response.ok) {
                    return response.text().then(text => {
                        throw new Error(`HTTP ${response.status}: ${text}`);
                    });
                }
                return response.json();
            })
            .then(result => {
                console.log('Delete result:', result);
                if (result.success) {
                    alert('Paste deleted successfully');
                    location.reload();
                } else {
                    alert('Delete failed: ' + result.error);
                }
            })
            .catch(error => {
                console.error('Delete error:', error);
                alert('Delete failed: ' + error.message);
            });
        }

        function logout() {
            fetch('/admin/logout', {
                method: 'POST',
                credentials: 'same-origin'
            })
            .then(response => {
                if (response.ok) {
                    window.location.href = '/admin/login';
                }
            })
            .catch(error => {
                console.error('Logout error:', error);
                alert('Logout failed');
            });
        }
        
        // Make functions globally available
        window.deletePaste = deletePaste;
        window.logout = logout;
        
        console.log('Admin functions loaded');
    </script>

        </main>
    </div>

<%- include('../partials/footer') %>