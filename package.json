{
  "name": "advanced-pastebin",
  "version": "2.0.0",
  "description": "GitHub-style pastebin service with TypeScript, SQLite/PostgreSQL, admin panel, and modern UI",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:debug": "ts-node-dev --inspect --respawn --transpile-only src/server.ts",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.{ts,js}",
    "type-check": "tsc --noEmit",
    "db:setup": "./setup_database.sh",
    "db:setup:simple": "sqlite3 pastebin.db < schema.sql && npm run db:generate",
    "db:reset": "./setup_database.sh",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "postinstall": "npx prisma generate"
  },
  "keywords": [
    "pastebin",
    "typescript",
    "sqlite",
    "admin",
    "express",
    "prisma"
  ],
  "author": "Murr <vtstv>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vtstv/pastebin.git"
  },
  "homepage": "https://github.com/vtstv/pastebin",
  "bugs": {
    "url": "https://github.com/vtstv/pastebin/issues"
  },
  "dependencies": {
    "@prisma/client": "^5.6.0",
    "@types/sqlite3": "^3.1.11",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "connect-pg-simple": "^9.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "highlight.js": "^11.9.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/express-session": "^1.17.10",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.9.0",
    "@types/uuid": "^9.0.7",
    "prisma": "^5.6.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}
